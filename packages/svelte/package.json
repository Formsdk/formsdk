{
  "name": "@formsdk/svelte",
  "version": "1.0.2",
  "description": "Svelte bindings for FormSDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "form",
    "svelte",
    "formsdk"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir=dist --format=esm --target=node --external svelte --external @formsdk/core",
    "pub": "bun run build && npm publish --access public"
  },
  "dependencies": {
    "@formsdk/core": "1.0.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "svelte": ">=4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "arjunaditya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/formsdk/formsdk"
  }
}
