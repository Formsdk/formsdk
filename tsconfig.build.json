{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": false,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": false,
    "declaration": true,
    "declarationDir": "./dist/types",
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/react", "src/core", "src/adapters"],
  "exclude": ["src/cli", "src/solid", "src/sveltekit", "src/astro", "src/tanstack", "src/solid.ts", "src/sveltekit.ts", "src/astro.ts", "src/tanstack.ts"]
}
