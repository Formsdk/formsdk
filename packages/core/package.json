{
  "name": "@formsdk/core",
  "version": "1.0.2",
  "description": "Framework-agnostic form validation and submission",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "form",
    "validation",
    "formsdk",
    "core"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir=dist --format=esm --target=node --external postgres --external @supabase/supabase-js --external @neondatabase/serverless --external @libsql/client --external @prisma/client --external drizzle-orm",
    "pub": "bun run build && npm publish --access public"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "arjunaditya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/formsdk/formsdk"
  }
}
